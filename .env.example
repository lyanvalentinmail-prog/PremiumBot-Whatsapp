# Bot
BOT_NAME=NombreBot
BOT_VERSION=1.0.0
PREFIX=.
OWNER_NAME=Owner
OWNER_NUMBER=
BOT_MODE=public

# WhatsApp: npm start permite elegir QR o código de vinculación en una terminal interactiva.
# Para procesos sin terminal (PM2/systemd), usa BOT_AUTH_METHOD=qr o pairing.
BOT_AUTH_METHOD=
# Solo para Pairing Code no interactivo; introduce dígitos con código de país.
PAIRING_NUMBER=

# API interna: por seguridad escucha solo localmente por defecto
API_HOST=127.0.0.1
API_PORT=3000
BOT_API_URL=http://127.0.0.1:3000
BOT_API_KEY=
API_CORS_ORIGIN=

# Proveedores opcionales (no se requieren para arrancar)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
WEATHER_API_KEY=
REMOVE_BG_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
YOUTUBE_API_KEY=
GENIUS_ACCESS_TOKEN=

# Seguridad y límites
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
MAX_DAILY_LIMIT=10
PREMIUM_DAILY_LIMIT=50
API_TIMEOUT_MS=15000
NODE_ENV=production
